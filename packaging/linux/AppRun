#!/bin/sh
# Entry point of the AppImage of Libre Panel, and of its Linux archive. Without a command (a
# double-click) Libre Panel starts in the background with its tray icon; with one it is the
# normal command line: ./Libre_Panel-x86_64.AppImage editor | autostart enable | ...
# The libraries of C that draw as Pillow draws (FreeType, HarfBuzz, libjpeg, libwebp: Pillow's
# own, in lib beside the program) the program names to itself (rust/app's name_own_libraries);
# nothing goes into LD_LIBRARY_PATH, so that the window and the tray icon use the system's GTK
# with the system's libraries.
HERE="$(dirname "$(readlink -f "$0")")"
APP="$HERE/usr/lib/libre-panel"
# (the same script starts the Linux archive's folder, libre-panel.sh beside the programs)
if [ ! -d "$APP" ]; then
    APP="$HERE"
fi
if [ "$#" -eq 0 ]; then
    set -- tray
fi
exec "$APP/libre-panel" "$@"
